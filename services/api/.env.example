# Copy to .env (never commit real values).
PORT=8787
# Bind to 127.0.0.1 for local use. Use 0.0.0.0 only behind an HTTPS reverse proxy.
HOST=127.0.0.1
DB_PATH=./data/sync.db
# Origin allowed to call the API from a browser (the desktop web preview). Use your exact origin in production.
CORS_ORIGIN=*
