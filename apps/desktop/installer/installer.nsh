; Mocchi installer additions (included by electron-builder; see electron-builder.yml).
;
; Adds a "Study content" page: the learner picks the JLPT level to work toward
; (N5 by default). N5 ships inside the installer; N4-N1 packs up to the chosen
; level are downloaded into resources\content. The app verifies every pack
; against its bundled manifest and re-downloads anything missing or corrupt.
;
; Silent install: Mocchi-Setup.exe /S /LEVEL=N3   (default: previous choice, else N5)

!ifndef BUILD_UNINSTALLER
  !include nsDialogs.nsh
  !include LogicLib.nsh
  !include FileFunc.nsh
  ; Generated by scripts/prepare-content.mjs from dist/content/manifest.json.
  !include "${PROJECT_DIR}\installer\levels.generated.nsh"

  Var ContentLevel
  Var ContentFailed
  Var RadioN5
  Var RadioN4
  Var RadioN3
  Var RadioN2
  Var RadioN1
!endif

!macro customPageAfterChangeDir
  Page custom MocchiContentPageCreate MocchiContentPageLeave

  Function MocchiContentPageCreate
    !insertmacro MUI_HEADER_TEXT "Study content" "Choose how much Japanese study content to install."
    nsDialogs::Create 1018
    Pop $0
    ${If} $0 == error
      Abort
    ${EndIf}
    ${If} $ContentLevel == ""
      ReadRegStr $ContentLevel HKCU "Software\Mocchi" "ContentLevel"
    ${EndIf}
    ${If} $ContentLevel == ""
      StrCpy $ContentLevel "N5"
    ${EndIf}

    ${NSD_CreateLabel} 0 0 100% 30u "Pick the JLPT level you want to work toward. Lower levels are always included. N5 is built in; higher levels are downloaded during setup. You can change this later in Mocchi's Settings."
    Pop $0
    ${NSD_CreateRadioButton} 10u 34u 100% 12u "N5 - beginner (built in)"
    Pop $RadioN5
    ${NSD_AddStyle} $RadioN5 ${WS_GROUP}
    ${NSD_CreateRadioButton} 10u 48u 100% 12u "Up to N4 - elementary (download ${MOCCHI_N4_TOTAL})"
    Pop $RadioN4
    ${NSD_CreateRadioButton} 10u 62u 100% 12u "Up to N3 - intermediate (download ${MOCCHI_N3_TOTAL})"
    Pop $RadioN3
    ${NSD_CreateRadioButton} 10u 76u 100% 12u "Up to N2 - upper intermediate (download ${MOCCHI_N2_TOTAL})"
    Pop $RadioN2
    ${NSD_CreateRadioButton} 10u 90u 100% 12u "Up to N1 - advanced, everything (download ${MOCCHI_N1_TOTAL})"
    Pop $RadioN1
    ${NSD_CreateLabel} 0 110u 100% 24u "Levels follow community JLPT word and kanji lists (not official lists). Dictionary data: JMdict/KANJIDIC2 (EDRDG, CC BY-SA 4.0), sentences from Tatoeba."
    Pop $0

    ${Select} $ContentLevel
      ${Case} "N4"
        ${NSD_Check} $RadioN4
      ${Case} "N3"
        ${NSD_Check} $RadioN3
      ${Case} "N2"
        ${NSD_Check} $RadioN2
      ${Case} "N1"
        ${NSD_Check} $RadioN1
      ${CaseElse}
        ${NSD_Check} $RadioN5
    ${EndSelect}
    nsDialogs::Show
  FunctionEnd

  Function MocchiContentPageLeave
    StrCpy $ContentLevel "N5"
    ${NSD_GetState} $RadioN4 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ContentLevel "N4"
    ${EndIf}
    ${NSD_GetState} $RadioN3 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ContentLevel "N3"
    ${EndIf}
    ${NSD_GetState} $RadioN2 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ContentLevel "N2"
    ${EndIf}
    ${NSD_GetState} $RadioN1 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $ContentLevel "N1"
    ${EndIf}
  FunctionEnd
!macroend

; Download one pack; on failure the app fetches it on first start.
!macro MocchiDownloadPack LEVEL FILE
  DetailPrint "Downloading JLPT ${LEVEL} study content..."
  ${If} ${Silent}
    inetc::get /SILENT /RESUME "" "${MOCCHI_CONTENT_URL}${FILE}" "$INSTDIR\resources\content\${FILE}" /END
  ${Else}
    inetc::get /CAPTION "JLPT ${LEVEL} study content" /RESUME "" "${MOCCHI_CONTENT_URL}${FILE}" "$INSTDIR\resources\content\${FILE}" /END
  ${EndIf}
  Pop $0
  ${If} $0 != "OK"
  ${AndIf} $0 != "Cancelled"
    inetc::get /SILENT /NOPROXY /RESUME "" "${MOCCHI_CONTENT_URL}${FILE}" "$INSTDIR\resources\content\${FILE}" /END
    Pop $0
  ${EndIf}
  ${If} $0 != "OK"
    Delete "$INSTDIR\resources\content\${FILE}"
    DetailPrint "Could not download JLPT ${LEVEL} content ($0). Mocchi will try again when it starts."
    StrCpy $ContentFailed "1"
  ${EndIf}
!macroend

!macro customInstall
  ; Silent installs skip the page: take /LEVEL=, else the previous choice, else N5.
  ${If} $ContentLevel == ""
    ${GetParameters} $1
    ClearErrors
    ${GetOptions} $1 "/LEVEL=" $ContentLevel
    ${If} ${Errors}
      ReadRegStr $ContentLevel HKCU "Software\Mocchi" "ContentLevel"
    ${EndIf}
  ${EndIf}
  ${If} $ContentLevel != "N4"
  ${AndIf} $ContentLevel != "N3"
  ${AndIf} $ContentLevel != "N2"
  ${AndIf} $ContentLevel != "N1"
    StrCpy $ContentLevel "N5"
  ${EndIf}

  CreateDirectory "$INSTDIR\resources\content"
  FileOpen $2 "$INSTDIR\resources\content\selection.json" w
  FileWrite $2 '{"targetLevel":"$ContentLevel"}'
  FileClose $2
  WriteRegStr HKCU "Software\Mocchi" "ContentLevel" $ContentLevel

  StrCpy $ContentFailed ""
  ${If} $ContentLevel != "N5"
    !insertmacro MocchiDownloadPack "N4" "${MOCCHI_N4_FILE}"
  ${EndIf}
  ${If} $ContentLevel == "N3"
  ${OrIf} $ContentLevel == "N2"
  ${OrIf} $ContentLevel == "N1"
    !insertmacro MocchiDownloadPack "N3" "${MOCCHI_N3_FILE}"
  ${EndIf}
  ${If} $ContentLevel == "N2"
  ${OrIf} $ContentLevel == "N1"
    !insertmacro MocchiDownloadPack "N2" "${MOCCHI_N2_FILE}"
  ${EndIf}
  ${If} $ContentLevel == "N1"
    !insertmacro MocchiDownloadPack "N1" "${MOCCHI_N1_FILE}"
  ${EndIf}

  ${If} $ContentFailed == "1"
  ${AndIfNot} ${Silent}
    MessageBox MB_OK|MB_ICONINFORMATION "Some study content could not be downloaded right now. Mocchi will download it automatically the next time it starts with an internet connection (Settings > Study content)."
  ${EndIf}
!macroend

!macro customUnInstall
  ${IfNot} ${isUpdated}
    DeleteRegValue HKCU "Software\Mocchi" "ContentLevel"
    DeleteRegKey /ifempty HKCU "Software\Mocchi"
  ${EndIf}
!macroend
